ADDITIONAL_INCLUDE_DIRS += -I..

# The unit under test is the theme's alert panel implementation (compiled
# into the theme bundle with ARC, so the tool must use it too).
# Every category file asks EauThemeIsActive() before it does anything
# Eau-specific; it lives in EauActivation.m so a tool can link one category
# without the theme class.
t_AlertPanelScrolling_OBJC_FILES += ../NSAlert+Eau.m ../EauActivation.m
t_AlertPanelScrolling_TOOL_LIBS += -lgnustep-gui -lgnustep-base -ldispatch

t_AlertPanelButtonRow_OBJC_FILES += ../NSAlert+Eau.m ../EauActivation.m
t_AlertPanelButtonRow_TOOL_LIBS += -lgnustep-gui -lgnustep-base -ldispatch

ADDITIONAL_OBJCFLAGS += -Wno-deprecated

# Runs against the theme bundle given with -GSTheme.  Space/Return on plain
# buttons is behavior from GershwinBehaviors.bundle, which Eau loads as its
# fallback when GSAppKitUserBundles does not name it.
t_ButtonSpaceKey_TOOL_LIBS += -lgnustep-gui -lgnustep-base

# The theme under test is loaded at run time with -GSTheme.
t_ProgressStripes_TOOL_LIBS += -lgnustep-gui -lgnustep-base

# Runs against the theme bundle given with -GSTheme.
t_SliderDisabled_TOOL_LIBS += -lgnustep-gui -lgnustep-base -lobjc

# Like the theme, the Dock progress hide timer is built with ARC.
t_RestartableTimer_OBJC_FILES += ../EauRestartableTimer.m
t_RestartableTimer_TOOL_LIBS += -lgnustep-base -lobjc
../EauRestartableTimer.m_FILE_FLAGS += -fobjc-arc

# Both units are Foundation-only pure geometry/data helpers for the EauTest
# showcase; keep them headless (no gnustep-gui link needed).
t_EauMetricsChecker_TOOL_LIBS += -lgnustep-base
t_EauShowcaseSectionRegistry_TOOL_LIBS += -lgnustep-base

# Pure geometry of the theme's NSDrawer windows; headless.
t_EauDrawerGeometry_OBJC_FILES += ../EauDrawerGeometry.m
t_EauDrawerGeometry_TOOL_LIBS += -lgnustep-base
